# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg2://hiremind:hiremind@localhost:5432/hiremind
SECRET_KEY=replace-with-a-long-random-string
TOKEN_MINUTES=120
UPLOAD_DIR=./uploads
# Optional: feedback drafts from the LLM (otherwise a fixed template). Never commit a real key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Only if your key is NOT scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
